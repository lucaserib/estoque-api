# Configuração do Banco de Dados
DATABASE_URL="postgresql://username:password@localhost:5432/estoque_db"

# Testes de navegador (Playwright, npm run test:e2e)
# Aponte DATABASE_URL para um banco DESCARTÁVEL antes de rodar — o
# e2e/global-setup.ts roda `prisma migrate deploy` e `prisma db seed`
# (que apaga e recria os dados de e2e@skubo.test a cada execução) nesse banco.

# NextAuth.js
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Mercado Livre API
ML_CLIENT_ID="seu_app_id_aqui"
ML_CLIENT_SECRET="sua_secret_key_aqui"
ML_REDIRECT_URI="http://localhost:3000/configuracoes"

# Outras configurações necessárias
# Em produção, altere ML_REDIRECT_URI para sua URL de produção
# Ex: ML_REDIRECT_URI="https://seu-dominio.com/configuracoes" 
# Bling API v3 (OAuth)
BLING_CLIENT_ID="seu_client_id_bling"
BLING_CLIENT_SECRET="seu_client_secret_bling"
BLING_REDIRECT_URI="http://localhost:3000/api/bling/auth/callback"
# Em produção: BLING_REDIRECT_URI="https://seu-dominio.com/api/bling/auth/callback"
# Webhook do Bling (POST /api/bling/webhook) reaproveita BLING_CLIENT_SECRET
# para validar o header X-Bling-Signature-256 (HMAC-SHA256). Cadastrar a URL
# https://seu-dominio.com/api/bling/webhook no app do Bling para os recursos
# Produto, Estoque e Produto-Fornecedor.

# Cron (Vercel)
# vercel.json tem crons de 5 em 5 minutos (email-fila) e de hora em hora
# (ciclo-de-vida): exigem o plano Pro — o Hobby só aceita cron diário.
CRON_SECRET="chave-secreta-para-crons"

# Criptografia de tokens em repouso (BlingAccount/MercadoLivreAccount)
# Chave de 32 bytes em base64 — gerar com: openssl rand -base64 32
# Sem essa variável, tokens novos são gravados em texto puro (sem quebrar
# nada) e tokens já criptografados não podem ser lidos — defina antes de
# qualquer conta ser conectada/reconectada em produção.
TOKEN_ENCRYPTION_KEY="defina-com-openssl-rand--base64-32"

# Cache compartilhado (Upstash Redis) — opcional, sem essas variáveis o cache cai para memória local por instância
# Também usado para rate limiting (src/lib/rateLimit.ts); sem elas, em produção o limite usa um contador no banco
UPSTASH_REDIS_REST_URL="https://seu-endpoint.upstash.io"
UPSTASH_REDIS_REST_TOKEN="seu-token-upstash"

# Monitoramento de erros (Sentry) — opcional, sem DSN o SDK não inicializa
NEXT_PUBLIC_SENTRY_DSN="https://sua-dsn@sentry.io/id-do-projeto"
SENTRY_DSN="https://sua-dsn@sentry.io/id-do-projeto"
SENTRY_ORG="sua-org-sentry"
SENTRY_PROJECT="seu-projeto-sentry"
SENTRY_AUTH_TOKEN="seu-token-de-auth-sentry"

# 0 desliga o contador de tentativas no banco (login, cadastro, senha, convites); 1 liga fora de produção
RATE_LIMIT_BANCO=

# Assinaturas e perguntas da IA (Mercado Pago) — sem MP_ACCESS_TOKEN o paywall fica desativado e ninguém é bloqueado
MP_ACCESS_TOKEN="seu-access-token-mercado-pago"
# Gerado ao configurar o webhook no painel do Mercado Pago; em produção, sem ele o webhook responde 503
MP_WEBHOOK_SECRET="sua-chave-secreta-do-webhook"
# 1 bloqueia contas vencidas mesmo sem Mercado Pago, 0 nunca bloqueia; vazio = bloqueia quando o MP está configurado
COBRANCA_OBRIGATORIA=
# 1 troca o Mercado Pago por um simulado (rotas /api/teste/mercadopago/*). Só e2e/desenvolvimento, nunca em ambiente público.
MP_PROVEDOR_FALSO=

# E-mails (Resend). Sem RESEND_API_KEY os e-mails só vão para o log do servidor.
RESEND_API_KEY=
# Segredo do webhook do Resend (POST /api/email/webhook), formato whsec_...
RESEND_WEBHOOK_SECRET=
# Remetente de um domínio verificado no Resend
EMAIL_REMETENTE="Skubo <ola@skubo.com.br>"
EMAIL_RESPONDER_PARA=
# Endereço ou CNPJ no rodapé de todo e-mail
EMPRESA_ENDERECO_RODAPE="Skubo · Brasil"
# console força o provedor de log (e2e/desenvolvimento); EMAIL_CONSOLE_ARQUIVO grava cada e-mail em JSONL
EMAIL_PROVEDOR=
EMAIL_CONSOLE_ARQUIVO=
# Assina os links de descadastro e da pesquisa de cancelamento — gerar com: openssl rand -hex 32
DESCADASTRO_SEGREDO=

# Meta (pixel e API de conversões) — opcional
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_CAPI_TOKEN=
# Código da aba "Testar eventos"; apague depois do teste
META_CAPI_TESTE=
META_GRAPH_VERSAO=v23.0

# Painel admin da plataforma (/admin ou subdomínio)
PLATFORM_ADMIN_EMAILS=voce@skubo.com.br
ADMIN_HOST=admin.skubo.com.br
AUTH_COOKIE_DOMAIN=.skubo.com.br
NEXT_PUBLIC_APP_URL=https://app.skubo.com.br

# Skubo IA (assistente, explicações nas telas, análise da Central e resumo semanal)
# Chave da Anthropic. Chave de usuário (sk-ant-usr…) também exige ANTHROPIC_WORKSPACE_ID (wrkspc_…).
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
# Modelos: o principal responde o chat e as análises; o rápido faz títulos, resumos de histórico e explicações curtas
IA_MODELO=claude-sonnet-5-5
IA_MODELO_RAPIDO=claude-haiku-5-5
# 1 desliga a IA para todo mundo sem deploy de código (kill switch)
IA_DESLIGADA=
# 1 troca a Anthropic por um provedor falso determinístico (e2e e desenvolvimento sem chave). Nunca em produção.
IA_PROVEDOR_FALSO=
# Preços em dólar por milhão de tokens (confira na página oficial de preços da Anthropic).
# Sem os quatro preços, o custo estimado fica vazio e o limite passa a contar mensagens.
IA_PRECO_ENTRADA_MTOK=2
IA_PRECO_SAIDA_MTOK=10
IA_PRECO_CACHE_LEITURA_MTOK=0.2
IA_PRECO_CACHE_ESCRITA_MTOK=2.5
# Opcional: preços do modelo rápido. Sem eles o modelo rápido é estimado com os preços acima (superestima).
IA_PRECO_RAPIDO_ENTRADA_MTOK=0.1
IA_PRECO_RAPIDO_SAIDA_MTOK=0.5
IA_PRECO_RAPIDO_CACHE_LEITURA_MTOK=0.01
IA_PRECO_RAPIDO_CACHE_ESCRITA_MTOK=0.125
IA_COTACAO_DOLAR=5.5
# Teto de segurança por conta (além das perguntas compradas): custo estimado no mês (centavos de R$) ou, sem preços, quantidade de mensagens.
# Pacotes, preço por pergunta e perguntas do teste ficam em Admin → Preços e ofertas, não aqui.
IA_ORCAMENTO_MENSAL_CENTAVOS=1000
IA_MENSAGENS_MENSAIS=300
# Conversas sem atividade há mais que isso são apagadas pelo cron ia-limpeza
IA_RETENCAO_DIAS=90
# Liberação sem gastar perguntas (piloto, parceiros, e2e): e-mails ou ids de conta separados por vírgula
IA_CONTAS_LIBERADAS=
# Link do botão "Falar com o suporte" (WhatsApp ou mailto). Sem ele, abre o manual.
NEXT_PUBLIC_SUPORTE_URL=

