generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  COMPRAS
  ESTOQUE
  VENDAS
  LEITURA
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum PrecoOrigem {
  BLING
  MANUAL
  ML
}

enum CustoOrigem {
  MANUAL
  PEDIDO_COMPRA
  BLING_FORNECEDOR
  BLING_PRODUTO
  PLANILHA
}

enum ArmazemTipo {
  LOCAL
  FULL_ML
  OUTRO
}

enum OrigemVinculoProduto {
  SKU_EXATO
  EAN
  SIMILARIDADE
  MANUAL
}

enum CanalVenda {
  MERCADO_LIVRE
  SHOPEE
  AMAZON
  MAGALU
  LOJA_PROPRIA
  ERP
  OUTRO
}

enum StatusVendaCanal {
  PAGA
  CANCELADA
  DEVOLVIDA
  DEVOLVIDA_PARCIAL
  EM_MEDIACAO
}

enum GrupoDre {
  RECEITA_BRUTA
  DEDUCAO_RECEITA
  IMPOSTO_VENDA
  CUSTO_VARIAVEL
  CMV
  DESPESA_OPERACIONAL
  RESULTADO_FINANCEIRO
  IMPOSTO_LUCRO
  NAO_OPERACIONAL
}

enum TipoLancamento {
  RECEITA
  DESPESA
  TRANSFERENCIA
}

enum StatusLancamento {
  PREVISTO
  PAGO
  CANCELADO
}

enum OrigemLancamento {
  MANUAL
  RECORRENCIA
  PARCELAMENTO
  CARTAO
  PEDIDO_COMPRA
  CANAL_COBRANCA
  CONCILIACAO
  ERP
}

enum Confianca {
  ESTIMADO
  CONFIRMADO
}

enum TipoContaFinanceira {
  BANCO
  CARTAO_CREDITO
  CARTEIRA_MARKETPLACE
  CAIXA
}

enum FrequenciaRecorrencia {
  SEMANAL
  MENSAL
  ANUAL
}

enum RegimeTributario {
  SIMPLES
  PRESUMIDO
  REAL
}

enum CancelamentoCompetencia {
  VENDA
  CANCELAMENTO
}

enum RateioCustoFixo {
  FATURAMENTO
  UNIDADE
  NENHUM
}

enum ModoFaturamento {
  PRODUTOS
  PRODUTOS_E_FRETE_COMPRADOR
  PRODUTOS_MENOS_FRETE
  PRODUTOS_E_FRETE_TOTAL
}

enum FreteOrigem {
  AJUSTE_MANUAL
  PAGAMENTO_CONFIRMADO
  CUSTO_ENVIO_CANAL
  CUSTO_PRODUTO
  PADRAO_LOGISTICA
  DESCONHECIDO
}

enum TemaPreferencia {
  CLARO
  ESCURO
  SISTEMA
}

enum TipoValorFreteLogistica {
  FIXO
  PERCENTUAL
}

model User {
  id                             String                          @id @default(uuid())
  name                           String?
  email                          String                          @unique
  password                       String?
  image                          String?
  role                           UserRole                        @default(ADMIN)
  contaId                        String?
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  conta                          User?                           @relation("MembrosDaConta", fields: [contaId], references: [id], onDelete: SetNull)
  membros                        User[]                          @relation("MembrosDaConta")
  accounts                       Account[]
  armazens                       Armazem[]
  Fornecedor                     Fornecedor[]
  pedidos                        PedidoCompra[]
  produtos                       Produto[]
  saidas                         Saida[]
  sessions                       Session[]
  BlingAccount                   BlingAccount[]
  MercadoLivreAccount            MercadoLivreAccount[]
  StockReplenishmentConfig       StockReplenishmentConfig[]
  transferencias                 TransferenciaEstoque[]
  notifications                  Notification[]
  movimentacoesEstoque           EstoqueMovimentacao[]
  subscription                   Subscription?
  invitationsSent                Invitation[]                    @relation("InvitationsSent")
  configuracaoGeral              ConfiguracaoGeral?
  onboardingProgresso            OnboardingProgresso?
  vendasCanal                    VendaCanal[]
  categoriasFinanceiras          CategoriaFinanceira[]
  contasFinanceiras              ContaFinanceira[]
  lancamentosFinanceiros         LancamentoFinanceiro[]
  recorrenciasFinanceiras        RecorrenciaFinanceira[]
  faturasCartao                  FaturaCartao[]
  gastosAdsCanal                 GastoAdsCanal[]
  cobrancasCanal                 CobrancaCanal[]
  resumosFinanceirosDiarios      ResumoFinanceiroDiario[]
  sincronizacoesFinanceiras      SincronizacaoFinanceira[]
  sincronizacoesFinanceirasErros SincronizacaoFinanceiraErro[]
  tarefasSincronizacaoFinanceira TarefaSincronizacaoFinanceira[]
  mapeamentosCategoriaBling      MapeamentoCategoriaBling[]
  regrasFreteLogistica           RegraFreteLogistica[]
  notasFiscaisVenda              NotaFiscalVenda[]
  analisesIa                     AnaliseIa[]
  receberResumoIa                Boolean                         @default(true)
  conversasIaConta               ConversaIa[]                    @relation("ConversasIaConta")
  conversasIaAutor               ConversaIa[]                    @relation("ConversasIaAutor")
  usosIa                         UsoIa[]
  emailVerificadoEm              DateTime?
  sessaoValidaDesde              DateTime?
  bloqueadoEm                    DateTime?
  motivoBloqueio                 String?
  tokensSenha                    TokenSenha[]
  preferencias                   Json?
  perfilCliente                  PerfilCliente?
  consentimentos                 ConsentimentoRegistro[]
  eventosProduto                 EventoProduto[]
  ultimoLoginEm                  DateTime?
  emailTarefas                   Boolean                         @default(true)
  quadrosTarefas                 QuadroTarefas[]                 @relation("QuadrosDaConta")
  tarefasDaConta                 Tarefa[]                        @relation("TarefasDaConta")
  tarefasResponsavel             Tarefa[]                        @relation("TarefasResponsavel")
  tarefasCriadas                 Tarefa[]                        @relation("TarefasCriadas")
  tarefasConcluidas              Tarefa[]                        @relation("TarefasConcluidas")
  etiquetasTarefas               EtiquetaTarefa[]
  comentariosTarefas             ComentarioTarefa[]
  atividadesTarefas              AtividadeTarefa[]
  itensChecklistConcluidos       ItemChecklistTarefa[]
  notasOperacaoConta             NotaOperacao[]                  @relation("NotasDaConta")
  notasOperacaoAutor             NotaOperacao[]                  @relation("NotasDoAutor")
  sequenciasConta                SequenciaConta[]

  @@index([contaId])
}

enum FinalidadeToken {
  REDEFINIR_SENHA
  CONFIRMAR_EMAIL
}

model TokenSenha {
  id         String          @id @default(uuid())
  userId     String
  finalidade FinalidadeToken
  tokenHash  String          @unique
  expiraEm   DateTime
  usadoEm    DateTime?
  ip         String?
  createdAt  DateTime        @default(now())
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, finalidade])
  @@map("tokens_senha")
}

model ContadorLimite {
  chave    String   @id
  contagem Int      @default(0)
  expiraEm DateTime

  @@index([expiraEm])
  @@map("contadores_limite")
}

model AuditoriaConta {
  id        String   @id @default(uuid())
  contaId   String
  autorId   String?
  acao      String
  alvoTipo  String?
  alvoId    String?
  detalhe   Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([contaId, createdAt])
  @@map("auditoria_conta")
}

model ConfiguracaoGeral {
  id                                String                  @id @default(uuid())
  userId                            String                  @unique
  aliquotaImposto                   Float                   @default(0)
  avgDeliveryDaysPadrao             Int                     @default(7)
  ultimaContagemPendenciasCriticas  Int                     @default(0)
  regimeTributario                  RegimeTributario        @default(SIMPLES)
  cancelamentoNaCompetencia         CancelamentoCompetencia @default(VENDA)
  rateioCustoFixo                   RateioCustoFixo         @default(FATURAMENTO)
  custoEnvioFlex                    Int?
  usarImpostoEstimado               Boolean                 @default(true)
  usarRelatorioLiberacaoMercadoPago Boolean                 @default(false)
  diasLiberacaoPadrao               Int                     @default(14)
  gerarContaAPagarAoConfirmarCompra Boolean                 @default(true)
  prazoPagamentoPadraoDias          Int                     @default(30)
  blingContasAtivo                  Boolean                 @default(false)
  metaFaturamentoMensal             Int?
  modoFaturamento                   ModoFaturamento         @default(PRODUTOS)
  nomeLoja                          String?
  logoUrl                           String?
  tema                              TemaPreferencia         @default(SISTEMA)
  createdAt                         DateTime                @default(now())
  updatedAt                         DateTime                @updatedAt
  user                              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("configuracoes_gerais")
}

model OnboardingProgresso {
  id            String   @id @default(uuid())
  userId        String   @unique
  etapasPuladas String[] @default([])
  tourVisto     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("onboarding_progresso")
}

model RegraFreteLogistica {
  id         String                  @id @default(uuid())
  userId     String
  logistica  String
  tipoValor  TipoValorFreteLogistica
  valor      Int                     @default(0)
  percentual Float                   @default(0)
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, logistica])
  @@map("regras_frete_logistica")
}

model Invitation {
  id          String           @id @default(uuid())
  email       String
  role        UserRole
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById String
  invitedBy   User             @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())

  @@map("invitations")
}

model MercadoLivreAccount {
  id                              String                    @id @default(uuid())
  userId                          String
  mlUserId                        String                    @unique
  accessToken                     String
  refreshToken                    String
  expiresAt                       DateTime
  nickname                        String
  siteId                          String
  isActive                        Boolean                   @default(true)
  ultimaSincronizacaoFinanceiraEm DateTime?
  financeiroProcessandoAte        DateTime?
  versaoDadosFinanceiros          Int                       @default(0)
  createdAt                       DateTime                  @default(now())
  updatedAt                       DateTime                  @updatedAt
  user                            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncHistories                   MercadoLivreSyncHistory[]
  webhooks                        MercadoLivreWebhook[]
  produtos                        ProdutoMercadoLivre[]

  @@unique([userId, mlUserId])
  @@map("mercado_livre_accounts")
}

model ProdutoMercadoLivre {
  id                     String                @id @default(uuid())
  produtoId              String?
  mercadoLivreAccountId  String
  mlItemId               String
  mlTitle                String
  mlPrice                Int
  mlAvailableQuantity    Int
  mlSoldQuantity         Int                   @default(0)
  mlStatus               String
  mlCondition            String                @default("new")
  mlListingType          String                @default("gold_special")
  mlPermalink            String?
  mlThumbnail            String?
  mlCategoryId           String?
  mlCategoryName         String?
  mlShippingMode         String?
  mlAcceptsMercadoPago   Boolean               @default(true)
  mlFreeShipping         Boolean               @default(false)
  mlLastUpdated          DateTime?
  lastSyncAt             DateTime              @default(now())
  syncStatus             String                @default("synced")
  syncError              String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  mlBasePrice            Int?
  mlHasPromotion         Boolean               @default(false)
  mlOriginalPrice        Int?
  mlPromotionDiscount    Int?
  mlSold90Days           Int?
  mlTarifaVenda          Int?
  mlCustoFrete           Int?
  mlLogisticType         String?
  mlInventoryId          String?
  mlCustosAtualizadosEm  DateTime?
  mlFullDisponivel       Int?
  mlFullEmTransito       Int?
  mlFullIndisponivel     Int?
  mlFullAtualizadoEm     DateTime?
  mlUltimoEnvioEstoqueEm DateTime?
  mlAutoStockPausado     Boolean               @default(false)
  mlVariationId          String?
  mlSellerSku            String?
  vinculoOrigem          OrigemVinculoProduto?
  vinculoConfirmado      Boolean               @default(true)
  mercadoLivreAccount    MercadoLivreAccount   @relation(fields: [mercadoLivreAccountId], references: [id], onDelete: Cascade)
  produto                Produto?              @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([mlItemId, mercadoLivreAccountId])
  @@map("produtos_mercado_livre")
}

model MercadoLivreSyncHistory {
  id                    String              @id @default(uuid())
  mercadoLivreAccountId String
  syncType              String
  status                String
  totalItems            Int                 @default(0)
  syncedItems           Int                 @default(0)
  newItems              Int                 @default(0)
  updatedItems          Int                 @default(0)
  errorItems            Int                 @default(0)
  errors                Json?
  startedAt             DateTime            @default(now())
  completedAt           DateTime?
  duration              Int?
  mercadoLivreAccount   MercadoLivreAccount @relation(fields: [mercadoLivreAccountId], references: [id], onDelete: Cascade)

  @@map("mercado_livre_sync_history")
}

model MercadoLivreWebhook {
  id                    String              @id @default(uuid())
  mercadoLivreAccountId String
  mlNotificationId      String              @unique
  resource              String
  userId                String
  topic                 String
  applicationId         String
  attempts              Int                 @default(0)
  processed             Boolean             @default(false)
  processedAt           DateTime?
  error                 String?
  receivedAt            DateTime            @default(now())
  mercadoLivreAccount   MercadoLivreAccount @relation(fields: [mercadoLivreAccountId], references: [id], onDelete: Cascade)

  @@map("mercado_livre_webhooks")
}

model Account {
  id                String   @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Produto {
  id                     String                 @id @default(uuid())
  nome                   String
  sku                    String
  isKit                  Boolean                @default(false)
  ean                    BigInt?
  userId                 String
  custoMedio             Int?
  custoOrigem            CustoOrigem?
  custoAtualizadoEm      DateTime?
  precoVenda             Int?
  precoOrigem            PrecoOrigem?
  blingId                String?
  imagemUrl              String?
  imagemThumbUrl         String?
  descricao              String?
  marca                  String?
  categoria              String?
  pesoGramas             Int?
  alturaCm               Int?
  larguraCm              Int?
  comprimentoCm          Int?
  custoFreteManual       Int?
  custoEmbalagem         Int?
  ativo                  Boolean                @default(true)
  componentes            Componente[]           @relation("KitToComponente")
  kitsComponentes        Componente[]           @relation("ProdutoToComponente")
  detalhesSaida          DetalhesSaida[]
  estoques               Estoque[]
  pedidos                PedidoProduto[]
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  fornecedores           ProdutoFornecedor[]
  saidas                 Saida[]
  ProdutoMercadoLivre    ProdutoMercadoLivre[]
  transferenciaItens     TransferenciaItem[]
  movimentacoesEstoque   EstoqueMovimentacao[]
  vendaCanalItens        VendaCanalItem[]
  lancamentosFinanceiros LancamentoFinanceiro[]
  gastosAdsCanal         GastoAdsCanal[]

  @@unique([sku, userId])
  @@unique([userId, blingId])
}

model Componente {
  id         Int     @id @default(autoincrement())
  quantidade Int
  produtoId  String
  kitId      String
  kit        Produto @relation("KitToComponente", fields: [kitId], references: [id], onDelete: Cascade)
  produto    Produto @relation("ProdutoToComponente", fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([kitId, produtoId])
}

model Estoque {
  produtoId        String
  armazemId        String
  quantidade       Int
  estoqueSeguranca Int?
  armazem          Armazem @relation(fields: [armazemId], references: [id], onDelete: Cascade)
  produto          Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@id([produtoId, armazemId])
}

enum OrigemMovimentacaoEstoque {
  IMPORTACAO_PLANILHA
  AJUSTE_MANUAL
  SINCRONIZACAO_FULL_ML
  SINCRONIZACAO_BLING
}

model EstoqueMovimentacao {
  id                 String                    @id @default(uuid())
  userId             String
  produtoId          String
  armazemId          String
  quantidadeAnterior Int
  quantidadeNova     Int
  origem             OrigemMovimentacaoEstoque
  observacao         String?
  createdAt          DateTime                  @default(now())
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  produto            Produto                   @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  armazem            Armazem                   @relation(fields: [armazemId], references: [id])

  @@index([produtoId, armazemId])
  @@index([userId])
  @@map("estoque_movimentacoes")
}

model Saida {
  id        String          @id @default(uuid())
  data      DateTime        @default(now())
  armazemId String
  produtoId String?
  userId    String
  detalhes  DetalhesSaida[]
  armazem   Armazem         @relation(fields: [armazemId], references: [id])
  produto   Produto?        @relation(fields: [produtoId], references: [id], onDelete: SetNull)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DetalhesSaida {
  id         Int     @id @default(autoincrement())
  saidaId    String
  produtoId  String
  quantidade Int
  isKit      Boolean
  produto    Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  saida      Saida   @relation(fields: [saidaId], references: [id], onDelete: Cascade)
}

model Armazem {
  id                    String                 @id @default(uuid())
  nome                  String
  userId                String
  blingDepositoId       String?
  tipo                  ArmazemTipo            @default(LOCAL)
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  estoques              Estoque[]
  saidas                Saida[]
  transferenciasDestino TransferenciaEstoque[] @relation("TransferenciaDestino")
  transferenciasOrigem  TransferenciaEstoque[] @relation("TransferenciaOrigem")
  movimentacoes         EstoqueMovimentacao[]

  @@unique([userId, blingDepositoId])
}

model Fornecedor {
  id                      String                  @id @default(uuid())
  nome                    String
  cnpj                    String?
  inscricaoEstadual       String?
  contato                 String?
  endereco                String?
  userId                  String
  blingContatoId          String?
  user                    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pedidos                 PedidoCompra[]
  produtos                ProdutoFornecedor[]
  lancamentosFinanceiros  LancamentoFinanceiro[]
  recorrenciasFinanceiras RecorrenciaFinanceira[]

  @@unique([userId, blingContatoId])
}

model PedidoCompra {
  id                     Int                    @id @default(autoincrement())
  fornecedorId           String
  comentarios            String?
  status                 String
  armazemId              String?
  dataPrevista           DateTime?
  dataConclusao          DateTime?
  userId                 String
  fornecedor             Fornecedor             @relation(fields: [fornecedorId], references: [id])
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  produtos               PedidoProduto[]
  lancamentosFinanceiros LancamentoFinanceiro[]

  @@index([userId])
}

model PedidoProduto {
  id            Int          @id @default(autoincrement())
  pedidoId      Int
  produtoId     String
  quantidade    Int
  custo         Int
  multiplicador Int          @default(1)
  pedido        PedidoCompra @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto       Produto      @relation(fields: [produtoId], references: [id], onDelete: Cascade)
}

model ProdutoFornecedor {
  id                 Int        @id @default(autoincrement())
  produtoId          String
  fornecedorId       String
  preco              Int
  multiplicador      Float
  codigoNF           String?
  prazoEntregaDias   Int?
  precoUnitario      Int?
  quantidadeMinima   Int?
  principal          Boolean    @default(false)
  codigoNoFornecedor String?
  fornecedor         Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  produto            Produto    @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([produtoId, fornecedorId])
}

model TransferenciaEstoque {
  id               String              @id @default(uuid())
  userId           String
  armazemOrigemId  String
  armazemDestinoId String
  data             DateTime            @default(now())
  observacoes      String?
  status           String              @default("concluida")
  itens            TransferenciaItem[]
  armazemDestino   Armazem             @relation("TransferenciaDestino", fields: [armazemDestinoId], references: [id])
  armazemOrigem    Armazem             @relation("TransferenciaOrigem", fields: [armazemOrigemId], references: [id])
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("transferencias_estoque")
}

model TransferenciaItem {
  id              Int                  @id @default(autoincrement())
  transferenciaId String
  produtoId       String
  quantidade      Int
  produto         Produto              @relation(fields: [produtoId], references: [id])
  transferencia   TransferenciaEstoque @relation(fields: [transferenciaId], references: [id], onDelete: Cascade)

  @@map("transferencia_itens")
}

model BlingAccount {
  id                          String             @id @default(uuid())
  userId                      String
  accessToken                 String
  refreshToken                String
  expiresAt                   DateTime
  isActive                    Boolean            @default(true)
  blingCompanyId              String?
  ultimaSincronizacaoProdutos DateTime?
  ultimaSincronizacaoEstoque  DateTime?
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt
  user                        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncHistories               BlingSyncHistory[]

  @@index([userId])
  @@map("bling_accounts")
}

model BlingWebhookEvent {
  id           String    @id @default(uuid())
  eventId      String    @unique
  event        String
  companyId    String?
  payload      Json
  processado   Boolean   @default(false)
  erro         String?
  recebidoEm   DateTime  @default(now())
  processadoEm DateTime?

  @@index([companyId])
  @@index([processado])
  @@map("bling_webhook_events")
}

model BlingSyncHistory {
  id             String       @id @default(uuid())
  blingAccountId String
  syncType       String
  status         String
  totalItems     Int          @default(0)
  syncedItems    Int          @default(0)
  newItems       Int          @default(0)
  updatedItems   Int          @default(0)
  errorItems     Int          @default(0)
  errors         Json?
  startedAt      DateTime     @default(now())
  completedAt    DateTime?
  duration       Int?
  blingAccount   BlingAccount @relation(fields: [blingAccountId], references: [id], onDelete: Cascade)

