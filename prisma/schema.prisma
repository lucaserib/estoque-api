generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  COMPRAS
  ESTOQUE
  VENDAS
  LEITURA
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum PrecoOrigem {
  BLING
  MANUAL
  ML
}

enum CustoOrigem {
  MANUAL
  PEDIDO_COMPRA
  BLING_FORNECEDOR
  BLING_PRODUTO
  PLANILHA
}

enum ArmazemTipo {
  LOCAL
  FULL_ML
  OUTRO
}

enum CanalVenda {
  MERCADO_LIVRE
  SHOPEE
  AMAZON
  MAGALU
  LOJA_PROPRIA
  ERP
  OUTRO
}

enum StatusVendaCanal {
  PAGA
  CANCELADA
  DEVOLVIDA
  DEVOLVIDA_PARCIAL
  EM_MEDIACAO
}

enum GrupoDre {
  RECEITA_BRUTA
  DEDUCAO_RECEITA
  IMPOSTO_VENDA
  CUSTO_VARIAVEL
  CMV
  DESPESA_OPERACIONAL
  RESULTADO_FINANCEIRO
  IMPOSTO_LUCRO
  NAO_OPERACIONAL
}

enum TipoLancamento {
  RECEITA
  DESPESA
  TRANSFERENCIA
}

enum StatusLancamento {
  PREVISTO
  PAGO
  CANCELADO
}

enum OrigemLancamento {
  MANUAL
  RECORRENCIA
  PARCELAMENTO
  CARTAO
  PEDIDO_COMPRA
  CANAL_COBRANCA
  CONCILIACAO
  ERP
}

enum Confianca {
  ESTIMADO
  CONFIRMADO
}

enum TipoContaFinanceira {
  BANCO
  CARTAO_CREDITO
  CARTEIRA_MARKETPLACE
  CAIXA
}

enum FrequenciaRecorrencia {
  SEMANAL
  MENSAL
  ANUAL
}

enum RegimeTributario {
  SIMPLES
  PRESUMIDO
  REAL
}

enum CancelamentoCompetencia {
  VENDA
  CANCELAMENTO
}

enum RateioCustoFixo {
  FATURAMENTO
  UNIDADE
  NENHUM
}

model User {
  id                       String                     @id @default(uuid())
  name                     String?
  email                    String                     @unique
  password                 String?
  image                    String?
  role                     UserRole                   @default(ADMIN)
  contaId                  String?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  conta                    User?                      @relation("MembrosDaConta", fields: [contaId], references: [id], onDelete: SetNull)
  membros                  User[]                     @relation("MembrosDaConta")
  accounts                 Account[]
  armazens                 Armazem[]
  Fornecedor               Fornecedor[]
  pedidos                  PedidoCompra[]
  produtos                 Produto[]
  saidas                   Saida[]
  sessions                 Session[]
  BlingAccount             BlingAccount[]
  MercadoLivreAccount      MercadoLivreAccount[]
  StockReplenishmentConfig StockReplenishmentConfig[]
  transferencias           TransferenciaEstoque[]
  notifications            Notification[]
  movimentacoesEstoque     EstoqueMovimentacao[]
  subscription             Subscription?
  invitationsSent          Invitation[]               @relation("InvitationsSent")
  configuracaoGeral        ConfiguracaoGeral?
  vendasCanal              VendaCanal[]
  categoriasFinanceiras    CategoriaFinanceira[]
  contasFinanceiras        ContaFinanceira[]
  lancamentosFinanceiros   LancamentoFinanceiro[]
  recorrenciasFinanceiras  RecorrenciaFinanceira[]
  faturasCartao            FaturaCartao[]
  gastosAdsCanal           GastoAdsCanal[]
  cobrancasCanal           CobrancaCanal[]
  resumosFinanceirosDiarios ResumoFinanceiroDiario[]
  sincronizacoesFinanceiras SincronizacaoFinanceira[]

  @@index([contaId])
}

model ConfiguracaoGeral {
  id                               String   @id @default(uuid())
  userId                           String   @unique
  aliquotaImposto                  Float    @default(0)
  avgDeliveryDaysPadrao            Int      @default(7)
  ultimaContagemPendenciasCriticas Int      @default(0)
  regimeTributario                 RegimeTributario         @default(SIMPLES)
  cancelamentoNaCompetencia        CancelamentoCompetencia  @default(VENDA)
  rateioCustoFixo                  RateioCustoFixo          @default(FATURAMENTO)
  custoEnvioFlex                   Int?
  usarImpostoEstimado              Boolean                  @default(true)
  usarRelatorioLiberacaoMercadoPago Boolean                  @default(false)
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt
  user                             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("configuracoes_gerais")
}

model Invitation {
  id          String           @id @default(uuid())
  email       String
  role        UserRole
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById String
  invitedBy   User             @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())

  @@map("invitations")
}

model MercadoLivreAccount {
  id            String                    @id @default(uuid())
  userId        String
  mlUserId      String                    @unique
  accessToken   String
  refreshToken  String
  expiresAt     DateTime
  nickname      String
  siteId        String
  isActive      Boolean                   @default(true)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  user          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncHistories MercadoLivreSyncHistory[]
  webhooks      MercadoLivreWebhook[]
  produtos      ProdutoMercadoLivre[]

  @@unique([userId, mlUserId])
  @@map("mercado_livre_accounts")
}

model ProdutoMercadoLivre {
  id                    String              @id @default(uuid())
  produtoId             String?
  mercadoLivreAccountId String
  mlItemId              String
  mlTitle               String
  mlPrice               Int
  mlAvailableQuantity   Int
  mlSoldQuantity        Int                 @default(0)
  mlStatus              String
  mlCondition           String              @default("new")
  mlListingType         String              @default("gold_special")
  mlPermalink           String?
  mlThumbnail           String?
  mlCategoryId          String?
  mlCategoryName        String?
  mlShippingMode        String?
  mlAcceptsMercadoPago  Boolean             @default(true)
  mlFreeShipping        Boolean             @default(false)
  mlLastUpdated         DateTime?
  lastSyncAt            DateTime            @default(now())
  syncStatus            String              @default("synced")
  syncError             String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  mlBasePrice           Int?
  mlHasPromotion        Boolean             @default(false)
  mlOriginalPrice       Int?
  mlPromotionDiscount   Int?
  mlSold90Days          Int?
  mlTarifaVenda         Int?
  mlCustoFrete          Int?
  mlLogisticType        String?
  mlInventoryId         String?
  mlCustosAtualizadosEm DateTime?
  mlFullDisponivel      Int?
  mlFullEmTransito      Int?
  mlFullIndisponivel    Int?
  mlFullAtualizadoEm    DateTime?
  mlUltimoEnvioEstoqueEm DateTime?
  mlAutoStockPausado    Boolean             @default(false)
  mlVariationId         String?
  mercadoLivreAccount   MercadoLivreAccount @relation(fields: [mercadoLivreAccountId], references: [id], onDelete: Cascade)
  produto               Produto?            @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([mlItemId, mercadoLivreAccountId])
  @@map("produtos_mercado_livre")
}

model MercadoLivreSyncHistory {
  id                    String              @id @default(uuid())
  mercadoLivreAccountId String
  syncType              String
  status                String
  totalItems            Int                 @default(0)
  syncedItems           Int                 @default(0)
  newItems              Int                 @default(0)
  updatedItems          Int                 @default(0)
  errorItems            Int                 @default(0)
  errors                Json?
  startedAt             DateTime            @default(now())
  completedAt           DateTime?
  duration              Int?
  mercadoLivreAccount   MercadoLivreAccount @relation(fields: [mercadoLivreAccountId], references: [id], onDelete: Cascade)

  @@map("mercado_livre_sync_history")
}

model MercadoLivreWebhook {
  id                    String              @id @default(uuid())
  mercadoLivreAccountId String
  mlNotificationId      String              @unique
  resource              String
  userId                String
  topic                 String
  applicationId         String
  attempts              Int                 @default(0)
  processed             Boolean             @default(false)
  processedAt           DateTime?
  error                 String?
  receivedAt            DateTime            @default(now())
  mercadoLivreAccount   MercadoLivreAccount @relation(fields: [mercadoLivreAccountId], references: [id], onDelete: Cascade)

  @@map("mercado_livre_webhooks")
}

model Account {
  id                String   @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Produto {
  id                   String                @id @default(uuid())
  nome                 String
  sku                  String
  isKit                Boolean               @default(false)
  ean                  BigInt?
  userId               String
  custoMedio           Int?
  custoOrigem          CustoOrigem?
  custoAtualizadoEm    DateTime?
  precoVenda           Int?
  precoOrigem          PrecoOrigem?
  blingId              String?
  imagemUrl            String?
  imagemThumbUrl       String?
  descricao            String?
  marca                String?
  categoria            String?
  pesoGramas           Int?
  alturaCm             Int?
  larguraCm            Int?
  comprimentoCm        Int?
  ativo                Boolean               @default(true)
  componentes          Componente[]          @relation("KitToComponente")
  kitsComponentes      Componente[]          @relation("ProdutoToComponente")
  detalhesSaida        DetalhesSaida[]
  estoques             Estoque[]
  pedidos              PedidoProduto[]
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  fornecedores         ProdutoFornecedor[]
  saidas               Saida[]
  ProdutoMercadoLivre  ProdutoMercadoLivre[]
  transferenciaItens   TransferenciaItem[]
  movimentacoesEstoque EstoqueMovimentacao[]
  vendaCanalItens      VendaCanalItem[]
  lancamentosFinanceiros LancamentoFinanceiro[]
  gastosAdsCanal       GastoAdsCanal[]

  @@unique([sku, userId])
  @@unique([userId, blingId])
}

model Componente {
  id         Int     @id @default(autoincrement())
  quantidade Int
  produtoId  String
  kitId      String
  kit        Produto @relation("KitToComponente", fields: [kitId], references: [id], onDelete: Cascade)
  produto    Produto @relation("ProdutoToComponente", fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([kitId, produtoId])
}

model Estoque {
  produtoId        String
  armazemId        String
  quantidade       Int
  estoqueSeguranca Int?
  armazem          Armazem @relation(fields: [armazemId], references: [id], onDelete: Cascade)
  produto          Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@id([produtoId, armazemId])
}

enum OrigemMovimentacaoEstoque {
  IMPORTACAO_PLANILHA
  AJUSTE_MANUAL
  SINCRONIZACAO_FULL_ML
  SINCRONIZACAO_BLING
}

model EstoqueMovimentacao {
  id                 String                    @id @default(uuid())
  userId             String
  produtoId          String
  armazemId          String
  quantidadeAnterior Int
  quantidadeNova     Int
  origem             OrigemMovimentacaoEstoque
  observacao         String?
  createdAt          DateTime                  @default(now())
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  produto            Produto                   @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  armazem            Armazem                   @relation(fields: [armazemId], references: [id])

  @@index([produtoId, armazemId])
  @@index([userId])
  @@map("estoque_movimentacoes")
}

model Saida {
  id        String          @id @default(uuid())
  data      DateTime        @default(now())
  armazemId String
  produtoId String?
  userId    String
  detalhes  DetalhesSaida[]
  armazem   Armazem         @relation(fields: [armazemId], references: [id])
  produto   Produto?        @relation(fields: [produtoId], references: [id], onDelete: SetNull)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DetalhesSaida {
  id         Int     @id @default(autoincrement())
  saidaId    String
  produtoId  String
  quantidade Int
  isKit      Boolean
  produto    Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  saida      Saida   @relation(fields: [saidaId], references: [id], onDelete: Cascade)
}

model Armazem {
  id                    String                 @id @default(uuid())
  nome                  String
  userId                String
  blingDepositoId       String?
  tipo                  ArmazemTipo            @default(LOCAL)
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  estoques              Estoque[]
  saidas                Saida[]
  transferenciasDestino TransferenciaEstoque[] @relation("TransferenciaDestino")
  transferenciasOrigem  TransferenciaEstoque[] @relation("TransferenciaOrigem")
  movimentacoes         EstoqueMovimentacao[]

  @@unique([userId, blingDepositoId])
}

model Fornecedor {
  id                String              @id @default(uuid())
  nome              String
  cnpj              String?
  inscricaoEstadual String?
  contato           String?
  endereco          String?
  userId            String
  blingContatoId    String?
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  pedidos           PedidoCompra[]
  produtos          ProdutoFornecedor[]
  lancamentosFinanceiros LancamentoFinanceiro[]
  recorrenciasFinanceiras RecorrenciaFinanceira[]

  @@unique([userId, blingContatoId])
}

model PedidoCompra {
  id            Int             @id @default(autoincrement())
  fornecedorId  String
  comentarios   String?
  status        String
  armazemId     String?
  dataPrevista  DateTime?
  dataConclusao DateTime?
  userId        String
  fornecedor    Fornecedor      @relation(fields: [fornecedorId], references: [id])
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  produtos      PedidoProduto[]
  lancamentosFinanceiros LancamentoFinanceiro[]

  @@index([userId])
}

model PedidoProduto {
  id            Int          @id @default(autoincrement())
  pedidoId      Int
  produtoId     String
  quantidade    Int
  custo         Int
  multiplicador Int          @default(1)
  pedido        PedidoCompra @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto       Produto      @relation(fields: [produtoId], references: [id], onDelete: Cascade)
}

model ProdutoFornecedor {
  id                 Int        @id @default(autoincrement())
  produtoId          String
  fornecedorId       String
  preco              Int
  multiplicador      Float
  codigoNF           String?
  prazoEntregaDias   Int?
  precoUnitario      Int?
  quantidadeMinima   Int?
  principal          Boolean    @default(false)
  codigoNoFornecedor String?
  fornecedor         Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  produto            Produto    @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([produtoId, fornecedorId])
}

model TransferenciaEstoque {
  id               String              @id @default(uuid())
  userId           String
  armazemOrigemId  String
  armazemDestinoId String
  data             DateTime            @default(now())
  observacoes      String?
  status           String              @default("concluida")
  itens            TransferenciaItem[]
  armazemDestino   Armazem             @relation("TransferenciaDestino", fields: [armazemDestinoId], references: [id])
  armazemOrigem    Armazem             @relation("TransferenciaOrigem", fields: [armazemOrigemId], references: [id])
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("transferencias_estoque")
}

model TransferenciaItem {
  id              Int                  @id @default(autoincrement())
  transferenciaId String
  produtoId       String
  quantidade      Int
  produto         Produto              @relation(fields: [produtoId], references: [id])
  transferencia   TransferenciaEstoque @relation(fields: [transferenciaId], references: [id], onDelete: Cascade)

  @@map("transferencia_itens")
}

model BlingAccount {
  id                          String             @id @default(uuid())
  userId                      String
  accessToken                 String
  refreshToken                String
  expiresAt                   DateTime
  isActive                    Boolean            @default(true)
  blingCompanyId              String?
  ultimaSincronizacaoProdutos DateTime?
  ultimaSincronizacaoEstoque  DateTime?
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt
  user                        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncHistories               BlingSyncHistory[]

  @@index([userId])
  @@map("bling_accounts")
}

model BlingWebhookEvent {
  id          String    @id @default(uuid())
  eventId     String    @unique
  event       String
  companyId   String?
  payload     Json
  processado  Boolean   @default(false)
  erro        String?
  recebidoEm  DateTime  @default(now())
  processadoEm DateTime?

  @@index([companyId])
  @@index([processado])
  @@map("bling_webhook_events")
}

model BlingSyncHistory {
  id             String       @id @default(uuid())
  blingAccountId String
  syncType       String
  status         String
  totalItems     Int          @default(0)
  syncedItems    Int          @default(0)
  newItems       Int          @default(0)
  updatedItems   Int          @default(0)
  errorItems     Int          @default(0)
  errors         Json?
  startedAt      DateTime     @default(now())
  completedAt    DateTime?
  duration       Int?
  blingAccount   BlingAccount @relation(fields: [blingAccountId], references: [id], onDelete: Cascade)

  @@map("bling_sync_history")
}

model StockReplenishmentConfig {
  id                 String   @id @default(uuid())
  userId             String
  produtoId          String
  avgDeliveryDays    Int      @default(7)
  fullReleaseDays    Int      @default(3)
  safetyStock        Int      @default(10)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  minCoverageDays    Int      @default(30)
  analysisPeriodDays Int      @default(90)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, produtoId])
  @@map("stock_replenishment_config")
}

enum NotificationType {
  ESTOQUE_CRITICO
  SYNC_ERRO
  BLING_EXPIRADO
  ML_EXPIRADO
  PEDIDO_CONCLUIDO
  CADASTRO_INCOMPLETO
  CONTA_A_VENCER
  CONTA_VENCIDA
  VENDA_COM_PREJUIZO
  DIVERGENCIA_CONCILIACAO
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum SubscriptionPlan {
  MONTHLY
  ANNUAL
}

model Subscription {
  id                     String             @id @default(uuid())
  userId                 String             @unique
  status                 SubscriptionStatus @default(TRIALING)
  plan                   SubscriptionPlan?
  mpPreapprovalId        String?            @unique
  mpPayerEmail           String?
  trialEndsAt            DateTime
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  billingCyclesCompleted Int                @default(0)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model VendaCanal {
  id                  String           @id @default(uuid())
  userId              String
  canal               CanalVenda
  contaCanalId        String
  pedidoExternoId     String
  pacoteExternoId     String?
  dataVenda           DateTime
  dataCancelamento    DateTime?
  dataLiberacao       DateTime?
  status              StatusVendaCanal
  logistica           String?
  envioExternoId      String?
  faturamentoBruto    Int
  descontoVendedor    Int
  tarifaVenda         Int
  freteVendedor       Int?
  freteComprador      Int
  impostoEstimado     Int
  adsAtribuido        Int
  cmv                 Int?
  outrosCustos        Int              @default(0)
  margemContribuicao  Int?
  valorLiquidoReceber Int?
  completo            Boolean          @default(true)
  faltando            String[]         @default([])
  freteConfianca      Confianca        @default(ESTIMADO)
  atualizadoNoCanalEm DateTime
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  itens               VendaCanalItem[]
  lancamentosFinanceiros LancamentoFinanceiro[]

  @@unique([userId, canal, pedidoExternoId])
  @@index([userId, dataVenda])
  @@index([userId, dataLiberacao])
  @@map("vendas_canal")
}

model VendaCanalItem {
  id                 String     @id @default(uuid())
  vendaId            String
  produtoId          String?
  sku                String?
  anuncioExternoId   String
  variacaoExternaId  String?
  titulo             String
  quantidade         Int
  precoUnitario      Int
  precoCheio         Int?
  tarifaVenda        Int
  freteRateado       Int?
  descontoRateado    Int        @default(0)
  impostoRateado     Int        @default(0)
  adsRateado         Int        @default(0)
  custoUnitario      Int?
  margemContribuicao Int?
  venda              VendaCanal @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  produto            Produto?   @relation(fields: [produtoId], references: [id], onDelete: SetNull)

  @@index([produtoId])
  @@index([vendaId])
  @@map("vendas_canal_itens")
}

model CategoriaFinanceira {
  id          String                 @id @default(uuid())
  userId      String
  nome        String
  grupoDre    GrupoDre
  paiId       String?
  sistema     Boolean                @default(false)
  ativo       Boolean                @default(true)
  ordem       Int                    @default(0)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  pai         CategoriaFinanceira?   @relation("CategoriaFinanceiraHierarquia", fields: [paiId], references: [id], onDelete: SetNull)
  filhas      CategoriaFinanceira[]  @relation("CategoriaFinanceiraHierarquia")
  lancamentos LancamentoFinanceiro[]
  recorrencias RecorrenciaFinanceira[]

  @@unique([userId, paiId, nome])
  @@map("categorias_financeiras")
}

model ContaFinanceira {
  id               String                 @id @default(uuid())
  userId           String
  nome             String
  tipo             TipoContaFinanceira
  saldoInicial     Int                    @default(0)
  dataSaldoInicial DateTime
  diaFechamento    Int?
  diaVencimento    Int?
  limite           Int?
  ativo            Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lancamentos      LancamentoFinanceiro[]
  recorrencias     RecorrenciaFinanceira[]
  faturas          FaturaCartao[]

  @@index([userId])
  @@map("contas_financeiras")
}

model LancamentoFinanceiro {
  id                  String           @id @default(uuid())
  userId               String
  tipo                 TipoLancamento
  descricao            String
  valor                Int
  categoriaId          String
  contaFinanceiraId    String?
  competencia          DateTime
  vencimento           DateTime
  pagamento            DateTime?
  status               StatusLancamento @default(PREVISTO)
  origem               OrigemLancamento @default(MANUAL)
  confianca            Confianca        @default(CONFIRMADO)
  fornecedorId         String?
  produtoId            String?
  pedidoCompraId       Int?
  vendaId              String?
  recorrenciaId        String?
  faturaCartaoId       String?
  grupoParcelamentoId  String?
  parcelaNumero        Int?
  parcelaTotal         Int?
  chaveExterna         String?
  anexoUrl             String?
  observacao           String?
  criadoPorId          String
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoria       CategoriaFinanceira    @relation(fields: [categoriaId], references: [id])
  contaFinanceira ContaFinanceira?       @relation(fields: [contaFinanceiraId], references: [id], onDelete: SetNull)
  fornecedor      Fornecedor?            @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  produto         Produto?               @relation(fields: [produtoId], references: [id], onDelete: SetNull)
  pedidoCompra    PedidoCompra?          @relation(fields: [pedidoCompraId], references: [id], onDelete: SetNull)
  venda           VendaCanal?            @relation(fields: [vendaId], references: [id], onDelete: SetNull)
  recorrencia     RecorrenciaFinanceira? @relation(fields: [recorrenciaId], references: [id], onDelete: SetNull)
  faturaCartao    FaturaCartao?          @relation(fields: [faturaCartaoId], references: [id], onDelete: SetNull)

  @@unique([userId, chaveExterna])
  @@index([userId, competencia])
  @@index([userId, vencimento, status])
  @@index([categoriaId])
  @@index([contaFinanceiraId])
  @@index([grupoParcelamentoId])
  @@map("lancamentos_financeiros")
}

model RecorrenciaFinanceira {
  id                String                @id @default(uuid())
  userId            String
  descricao         String
  valor             Int
  categoriaId       String
  contaFinanceiraId String?
  fornecedorId      String?
  frequencia        FrequenciaRecorrencia
  diaVencimento     Int
  inicio            DateTime
  fim               DateTime?
  ativo             Boolean               @default(true)
  geradoAte         DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoria       CategoriaFinanceira    @relation(fields: [categoriaId], references: [id])
  contaFinanceira ContaFinanceira?       @relation(fields: [contaFinanceiraId], references: [id], onDelete: SetNull)
  fornecedor      Fornecedor?            @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  lancamentos     LancamentoFinanceiro[]

  @@index([userId])
  @@map("recorrencias_financeiras")
}

model FaturaCartao {
  id                    String           @id @default(uuid())
  userId                String
  contaFinanceiraId     String
  mesReferencia         String
  fechamento            DateTime
  vencimento            DateTime
  status                StatusLancamento @default(PREVISTO)
  lancamentoPagamentoId String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  contaFinanceira ContaFinanceira        @relation(fields: [contaFinanceiraId], references: [id], onDelete: Cascade)
  lancamentos     LancamentoFinanceiro[]

  @@unique([contaFinanceiraId, mesReferencia])
  @@map("faturas_cartao")
}

model GastoAdsCanal {
  id                String     @id @default(uuid())
  userId            String
  canal             CanalVenda
  contaCanalId      String
  dia               DateTime
  campanhaExternaId String?
  anuncioExternoId  String?
  produtoId         String?
  custo             Int
  cliques           Int?
  impressoes        Int?
  vendasAtribuidas  Int?
  receitaAtribuida  Int?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  produto Produto? @relation(fields: [produtoId], references: [id], onDelete: SetNull)

  @@unique([userId, canal, dia, campanhaExternaId, anuncioExternoId])
  @@index([userId, dia])
  @@map("gastos_ads_canal")
}

model CobrancaCanal {
  id               String     @id @default(uuid())
  userId           String
  canal            CanalVenda
  contaCanalId     String
  mesReferencia    String
  detalheExternoId String
  tipoExterno      String
  tipoNormalizado  String
  valor            Int
  pedidoExternoId  String?
  anuncioExternoId String?
  data             DateTime
  coberturaPedido  Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, canal, detalheExternoId])
  @@index([userId, mesReferencia])
  @@map("cobrancas_canal")
}

model ResumoFinanceiroDiario {
  id                 String     @id @default(uuid())
  userId             String
  dia                DateTime
  canal              CanalVenda
  pedidos            Int        @default(0)
  unidades           Int        @default(0)
  faturamentoBruto   Int        @default(0)
  cancelamentos      Int        @default(0)
  descontos          Int        @default(0)
  impostos           Int        @default(0)
  tarifas            Int        @default(0)
  frete              Int        @default(0)
  ads                Int        @default(0)
  cmv                Int        @default(0)
  margemContribuicao Int        @default(0)
  vendasIncompletas  Int        @default(0)
  atualizadoEm       DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dia, canal])
  @@map("resumos_financeiros_diarios")
}

model SincronizacaoFinanceira {
  id          String     @id @default(uuid())
  userId      String
  canal       CanalVenda
  tipo        String
  cursor      Json?
  status      String
  iniciadoEm  DateTime   @default(now())
  concluidoEm DateTime?
  processados Int        @default(0)
  erro        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, canal, tipo])
  @@map("sincronizacoes_financeiras")
}
