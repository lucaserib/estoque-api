enum PrioridadeTarefa {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum PapelColunaTarefa {
  A_FAZER
  EM_ANDAMENTO
  CONCLUIDA
}

enum OrigemTarefa {
  MANUAL
  CAPTURA_RAPIDA
  NOTA
  RECORRENCIA
  ROTINA_SUGERIDA
  CENTRAL_CONTROLE
  REPOSICAO
  SAUDE_ANUNCIOS
  PRODUTO
  PEDIDO_COMPRA
}

enum TipoVinculoTarefa {
  PRODUTO
  ANUNCIO_ML
  PEDIDO_COMPRA
  FORNECEDOR
  TELA
}

enum TipoAtividadeTarefa {
  CRIADA
  EDITADA
  MOVIDA
  ATRIBUIDA
  PRAZO
  PRIORIDADE
  ETIQUETAS
  CONCLUIDA
  REABERTA
  ARQUIVADA
  RESTAURADA
  COMENTARIO
  CHECKLIST
  RECORRENCIA
}

enum TipoNotaOperacao {
  NOTA
  IDEIA
}

enum VisibilidadeNota {
  EQUIPE
  PRIVADA
}

model QuadroTarefas {
  id          String          @id @default(uuid())
  contaId     String
  nome        String
  descricao   String?
  cor         String          @default("azul")
  posicao     Float
  padrao      Boolean         @default(false)
  arquivadoEm DateTime?
  criadoPorId String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  conta       User            @relation("QuadrosDaConta", fields: [contaId], references: [id], onDelete: Cascade)
  colunas     ColunaTarefas[]
  tarefas     Tarefa[]

  @@index([contaId, arquivadoEm])
  @@map("quadros_tarefas")
}

model ColunaTarefas {
  id        String            @id @default(uuid())
  quadroId  String
  nome      String
  papel     PapelColunaTarefa @default(A_FAZER)
  posicao   Float
  limite    Int?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  quadro    QuadroTarefas     @relation(fields: [quadroId], references: [id], onDelete: Cascade)
  tarefas   Tarefa[]

  @@index([quadroId, posicao])
  @@map("colunas_tarefas")
}

model Tarefa {
  id             String                @id @default(uuid())
  contaId        String
  numero         Int
  quadroId       String
  colunaId       String
  titulo         String
  descricao      String?
  prioridade     PrioridadeTarefa      @default(MEDIA)
  posicao        Float
  responsavelId  String?
  criadoPorId    String?
  prazo          DateTime?
  prazoComHora   Boolean               @default(false)
  concluidaEm    DateTime?
  concluidaPorId String?
  arquivadaEm    DateTime?
  origem         OrigemTarefa          @default(MANUAL)
  chaveOrigem    String?
  vinculoTipo    TipoVinculoTarefa?
  vinculoId      String?
  vinculoRotulo  String?
  vinculoHref    String?
  recorrencia    Json?
  serieId        String?
  versao         Int                   @default(1)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  conta          User                  @relation("TarefasDaConta", fields: [contaId], references: [id], onDelete: Cascade)
  quadro         QuadroTarefas         @relation(fields: [quadroId], references: [id], onDelete: Cascade)
  coluna         ColunaTarefas         @relation(fields: [colunaId], references: [id], onDelete: NoAction)
  responsavel    User?                 @relation("TarefasResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  criadoPor      User?                 @relation("TarefasCriadas", fields: [criadoPorId], references: [id], onDelete: SetNull)
  concluidaPor   User?                 @relation("TarefasConcluidas", fields: [concluidaPorId], references: [id], onDelete: SetNull)
  etiquetas      TarefaEtiqueta[]
  checklist      ItemChecklistTarefa[]
  comentarios    ComentarioTarefa[]
  atividades     AtividadeTarefa[]
  notas          NotaOperacao[]

  @@unique([contaId, numero])
  @@unique([contaId, chaveOrigem])
  @@unique([serieId, prazo])
  @@index([contaId, arquivadaEm, concluidaEm])
  @@index([contaId, responsavelId, concluidaEm])
  @@index([contaId, prazo])
  @@index([colunaId, posicao])
  @@map("tarefas")
}

model EtiquetaTarefa {
  id        String           @id @default(uuid())
  contaId   String
  nome      String
  cor       String
  createdAt DateTime         @default(now())
  conta     User             @relation(fields: [contaId], references: [id], onDelete: Cascade)
  tarefas   TarefaEtiqueta[]

  @@unique([contaId, nome])
  @@map("etiquetas_tarefas")
}

model TarefaEtiqueta {
  tarefaId   String
  etiquetaId String
  tarefa     Tarefa         @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  etiqueta   EtiquetaTarefa @relation(fields: [etiquetaId], references: [id], onDelete: Cascade)

  @@id([tarefaId, etiquetaId])
  @@index([etiquetaId])
  @@map("tarefas_etiquetas")
}

model ItemChecklistTarefa {
  id             String    @id @default(uuid())
  tarefaId       String
  texto          String
  concluido      Boolean   @default(false)
  posicao        Float
  concluidoPorId String?
  concluidoEm    DateTime?
  createdAt      DateTime  @default(now())
  tarefa         Tarefa    @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  concluidoPor   User?     @relation(fields: [concluidoPorId], references: [id], onDelete: SetNull)

  @@index([tarefaId, posicao])
  @@map("itens_checklist_tarefa")
}

model ComentarioTarefa {
  id        String    @id @default(uuid())
  tarefaId  String
  autorId   String?
  corpo     String
  mencoes   String[]  @default([])
  editadoEm DateTime?
  createdAt DateTime  @default(now())
  tarefa    Tarefa    @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  autor     User?     @relation(fields: [autorId], references: [id], onDelete: SetNull)

  @@index([tarefaId, createdAt])
  @@map("comentarios_tarefa")
}

model AtividadeTarefa {
  id        String              @id @default(uuid())
  tarefaId  String
  autorId   String?
  tipo      TipoAtividadeTarefa
  dados     Json?
  createdAt DateTime            @default(now())
  tarefa    Tarefa              @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  autor     User?               @relation(fields: [autorId], references: [id], onDelete: SetNull)

  @@index([tarefaId, createdAt])
  @@map("atividades_tarefa")
}

model NotaOperacao {
  id           String           @id @default(uuid())
  contaId      String
  autorId      String?
  tipo         TipoNotaOperacao @default(NOTA)
  titulo       String?
  conteudo     String
  cor          String           @default("amarelo")
  fixada       Boolean          @default(false)
  visibilidade VisibilidadeNota @default(EQUIPE)
  posicao      Float
  apoios       String[]         @default([])
  tarefaId     String?
  arquivadaEm  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  conta        User             @relation("NotasDaConta", fields: [contaId], references: [id], onDelete: Cascade)
  autor        User?            @relation("NotasDoAutor", fields: [autorId], references: [id], onDelete: SetNull)
  tarefa       Tarefa?          @relation(fields: [tarefaId], references: [id], onDelete: SetNull)

  @@index([contaId, arquivadaEm])
  @@index([autorId])
  @@map("notas_operacao")
}

model SequenciaConta {
  contaId String
  chave   String
  valor   Int
  conta   User   @relation(fields: [contaId], references: [id], onDelete: Cascade)

  @@id([contaId, chave])
  @@map("sequencias_conta")
}
